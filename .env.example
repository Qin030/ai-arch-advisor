# 複製成 .env 後填入。.env 不進版控。

# 商用 API（摘要與白話轉譯用）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 自架模型（嵌入與重排序）
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 路徑
KB_PATH=data/kb
CHROMA_PATH=.chroma
DB_URL=sqlite:///./app.sqlite3

# 地區白名單 —— 不在清單內的地區一律拒答，不做跨區推定
# MVP 階段只有臺南。加地區要同步加知識庫切片，否則會拒答不了也答不好
REGION_ALLOWLIST=tainan

# 知識庫版本過期門檻（天）。超過就附過期警示
KB_STALE_DAYS=365
